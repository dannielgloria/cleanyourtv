<?xml version="1.0" encoding="utf-8"?>
<!-- Static translucent layers; 21dp corners form circles on the existing 42dp icon buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="#D9182435" /><corners android:radius="21dp" /></shape></item>
            <item><shape>
                <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#12FFFFFF" />
                <stroke android:width="2dp" android:color="#FFFFFFFF" />
                <corners android:radius="21dp" />
            </shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#B3202A36" /><corners android:radius="21dp" /></shape></item>
            <item><shape>
                <gradient android:angle="270" android:startColor="#30FFFFFF" android:endColor="#08FFFFFF" />
                <stroke android:width="1dp" android:color="#66FFFFFF" />
                <corners android:radius="21dp" />
            </shape></item>
        </layer-list>
    </item>
</selector>
